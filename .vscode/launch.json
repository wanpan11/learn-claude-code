{
  // 使用 IntelliSense 了解相关属性。
  // 悬停以查看现有属性的描述。
  // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node-terminal",
      "name": "运行脚本: dev (node)",
      "request": "launch",
      "command": "npm run ${input:scriptName}",
      "cwd": "${workspaceFolder}\\node"
    }
  ],
  "inputs": [
    {
      "id": "scriptName",
      "type": "pickString",
      "description": "选择要运行的脚本",
      "options": ["dev3", "dev6", "dev7", "dev8", "dev9", "dev10", "dev11", "dev12"],
      "default": "dev6"
    }
  ]
}
